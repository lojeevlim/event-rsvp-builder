# ---- Required: database (Neon Postgres) ----------------------------------
# Users, events, guest replies and email templates live here. The tables are created automatically.
DATABASE_URL=
# ---- Required: sign-in (Clerk) -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Paths of the sign-in pages (leave as is)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Super admins ---------------------------------------------------------
# Emails that become super admins when they first sign in (comma separated). Everyone else who signs up is a host.
SUPER_ADMIN_EMAILS=lojeevlim@gmail.com

# ---- Email --------------------------------------------------------------
# Invitation, confirmation and host "new reply" emails are sent through Gmail (free, no domain, about 500 a day).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=   # a 16-character app password: Google account > Security > 2-Step Verification > App passwords
# Site-wide cap on emails per 24 hours (default 400, to stay under Gmail's limit):
# EMAIL_DAILY_LIMIT=400

# ---- Image uploads: Cloudflare R2 ----------------------------------------
# Without these, images are saved in data/uploads (fine locally, not on Vercel).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Optional ------------------------------------------------------------
# The public address of the site, used in event links and emails. Defaults to the address of the request.
# NEXT_PUBLIC_APP_URL=https://events.example.com
# MAX_EVENTS_PER_HOST=20
# MAX_INVITES_PER_DAY=200

# Stops Clerk's telemetry notice in the dev console
CLERK_TELEMETRY_DISABLED=1
