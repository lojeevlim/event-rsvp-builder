# ---- Required: database (Neon Postgres) ----------------------------------
# Users, events, guest replies and email templates live here. The tables are created automatically.
DATABASE_URL=
# ---- Required: sign-in (Clerk) -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Paths of the sign-in pages (leave as is)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Super admins ---------------------------------------------------------
# Emails that become super admins when they first sign in (comma separated). Everyone else who signs up is a host.
SUPER_ADMIN_EMAILS=lojeevlim@gmail.com

# ---- Email: Resend -------------------------------------------------------
# Sends the invitation and confirmation emails. Without RESEND_API_KEY, Gmail below is used.
RESEND_API_KEY=
# EMAIL_FROM=Event RSVP <rsvp@your-verified-domain.com>

# ---- Image uploads: Cloudflare R2 ----------------------------------------
# Without these, images are saved in data/uploads (fine locally, not on Vercel).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Optional ------------------------------------------------------------
# The public address of the site, used in event links and emails. Defaults to the address of the request.
# NEXT_PUBLIC_APP_URL=https://events.example.com
# MAX_EVENTS_PER_HOST=20
# MAX_INVITES_PER_DAY=200

# ---- Gmail fallback for email (only when RESEND_API_KEY is not set) ------
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=
